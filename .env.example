# Run python3 scripts/init_env.py to generate local secrets into .env.
DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-64-character-secret
CREDENTIAL_KEY=replace-with-a-Fernet-key
GATEWAY_TOKEN=replace-with-a-random-32-character-or-longer-token
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://whatsbridge:replace-with-a-random-database-password@db:5432/whatsbridge
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
PUBLIC_URL=http://localhost:8080
GATEWAY_URL=http://gateway:4000
# Select a currently supported Meta Graph API version before live onboarding.
META_GRAPH_VERSION=
# Only verified AUTHENTICATION-category template names should be listed here.
OTP_TEMPLATE_NAMES=
# Comma-separated exact HTTPS hostnames approved by the operator for outbound calls.
WEBHOOK_ALLOWED_HOSTS=
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_USE_TLS=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WhatsBridge <hello@localhost>
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional isolated experimental linked-device service (no OTP)
BAILEYS_ENABLED=0
BAILEYS_URL=http://127.0.0.1:14001
BAILEYS_TOKEN=
